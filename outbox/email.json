               <td style=\"padding: 8px; border-bottom: 1px solid #f3f4f6; font-weight: 600;\">OTLK</td>\n                  <td style=\"padding: 8px; border-bottom: 1px solid #f3f4f6; text-align: right; color: #dc2626;\">-54%</td>\n                  <td style=\"padding: 8px; border-bottom: 1px solid #f3f4f6;\">Second FDA CRL for ONS-5010 (wet AMD)</td>\n                  <td style=\"padding: 8px; border-bottom: 1px solid #f3f4f6;\">CRL</td>\n                  <td style=\"padding: 8px; border-bottom: 1px solid #f3f4f6;\">None</td>\n                </tr>\n              </tbody>\n            </table>\n          </td>\n        </tr>\n\n        <!-- LARGE CAP ON DECK -->\n        <tr>\n          <td style=\"padding: 0 24px 20px 24px;\">\n            <p style=\"margin: 0 0 10px 0; font-size: 16px; font-weight: 600;\">🏢 Large-cap on deck — next 21 days</p>\n            <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-collapse: collapse; font-size: 12px;\">\n              <thead>\n                <tr style=\"background-color: #f9fafb;\">\n                  <th style=\"text-align: left; padding: 8px; color: #6b7280; border-bottom: 1px solid #e5e7eb;\">Ticker</th>\n                  <th style=\"text-align: left; padding: 8px; color: #6b7280; border-bottom: 1px solid #e5e7eb;\">Event</th>\n                  <th style=\"text-align: left; padding: 8px; color: #6b7280; border-bottom: 1px solid #e5e7eb;\">Date</th>\n                  <th style=\"text-align: left; padding: 8px; color: #6b7280; border-bottom: 1px solid #e5e7eb;\">Setup</th>\n                  <th style=\"text-align: left; padding: 8px; color: #6b7280; border-bottom: 1px solid #e5e7eb;\">Direction</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr>\n                  <td style=\"padding: 8px; border-bottom: 1px solid #f3f4f6; font-weight: 600;\">TSM</td>\n                  <td style=\"padding: 8px; border-bottom: 1